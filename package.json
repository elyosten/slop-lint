{
  "name": "@elyosten/slop-lint",
  "version": "0.1.0-dev.0",
  "description": "A bilingual prose linter for formulaic writing",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/elyosten/slop-lint.git" },
  "engines": { "node": ">=20.19" },
  "bin": { "slop-lint": "dist/cli/index.js" },
  "exports": { ".": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" } },
  "files": ["dist", "rules", "schema", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsup",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run build:web && npm test",
    "prepack": "npm run build"
  },
  "dependencies": { "ajv": "^8.17.1", "mdast-util-from-markdown": "^2.0.2", "yaml": "^2.9.1" },
  "devDependencies": { "@types/node": "^20.19.0", "esbuild": "^0.28.2", "jsdom": "^27.4.0", "tsup": "^9.0.0", "typescript": "~5.9.3", "vitest": "^4.1.12" },
  "overrides": { "esbuild": "$esbuild" }
}
